# 由 nginx 官方镜像的 docker-entrypoint 用 envsubst 渲染到 /etc/nginx/conf.d/default.conf
# 只需要替换 PORT；其余 $ 变量保持原样
server {
    listen       ${PORT};
    listen       [::]:${PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    charset utf-8;
    server_tokens off;
    absolute_redirect off;

    # 文本类资源压缩
    gzip              on;
    gzip_vary         on;
    gzip_comp_level   6;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml;

    # index.html 不缓存，保证发版即生效（页面内资源都带 ?v= 或短缓存）
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # HTML / 根路径：永远回落到单页
    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:css|js)$ {
        expires 1h;
        add_header Cache-Control "public, max-age=3600";
    }

    location ~* \.(?:webp|png|jpe?g|gif|svg|ico|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
    }

    # 静态站没有 /api，健康检查走这个
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }
}
